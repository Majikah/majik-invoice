{
  "name": "@majikah/majik-invoice",
  "type": "module",
  "description": "Domain model for post-quantum secured invoices — base GeneralInvoice with double-entry accounting projections, and MajikInvoice with hybrid Ed25519 + ML-DSA-87 signing and optional ML-KEM-768 encryption.",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "author": "Zelijah",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./invoice": {
      "types": "./dist/core/general-invoice/index.d.ts",
      "import": "./dist/core/general-invoice/index.js",
      "default": "./dist/core/general-invoice/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majikah/majik-invoice.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jedlsf"
  },
  "keywords": [
    "invoice",
    "accounting",
    "double-entry",
    "journal-entry",
    "post-quantum",
    "cryptography",
    "digital-signature",
    "ed25519",
    "ml-dsa",
    "ml-kem",
    "encryption",
    "majikah",
    "majik",
    "finance",
    "tax",
    "vat",
    "bir",
    "philippines",
    "typescript",
    "esm"
  ],
  "homepage": "https://github.com/Majikah/majik-invoice#readme",
  "bugs": {
    "url": "https://github.com/Majikah/majik-invoice/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "package": "npm run build && npm version patch && git push && git push --tags",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:csv": "vitest run test/csv-export.test.ts",
    "test:gi": "vitest run test/general-invoice.test.ts",
    "test:li": "vitest run test/line-item.test.ts",
    "test:totals": "vitest run test/invoice-totals.test.ts",
    "test:tax": "vitest run test/tax-manager.test.ts",
    "test:core": "vitest run test/majik-invoice.test.ts"
  },
  "dependencies": {
    "@majikah/majik-envelope": "^0.3.0",
    "@majikah/majik-key": "^1.0.2",
    "@majikah/majik-signature": "^0.9.4",
    "@noble/hashes": "^2.4.0",
    "@stablelib/sha256": "^2.0.1",
    "@thezelijah/majik-money": "^2.2.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "vitest": "^5.0.3"
  }
}
